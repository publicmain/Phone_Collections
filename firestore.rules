rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 班级文档 ID 由访问口令派生（见 src/config/access.ts:deriveClassDocId）：
    //   cls_ + sha256('classdoc:' + 口令) 前 24 位十六进制
    // 因此「知道口令」等价于「知道数据路径」，路径本身就是凭据。
    function isDerivedClassId(classId) {
      return classId is string
        && classId.size() == 28
        && classId.matches('^cls_[0-9a-f]{24}$');
    }

    match /classes/{classId} {
      // 只允许 get（按完整路径精确读取），不允许 list。
      // 少了 list，外人无法枚举 classes 集合去撞出文档 ID。
      allow get, write: if isDerivedClassId(classId);
      allow list: if false;

      match /inspections/{inspectionId} {
        // 子集合需要 list：统计页要按日期查询全部点验记录。
        // 但前提是已经知道父文档 ID，所以不构成额外暴露。
        allow read, write: if isDerivedClassId(classId);
      }
    }

    // 旧路径 classes/main_class 已废弃。
    // 迁移完成、确认数据已出现在新路径后，把下面这条整段删掉即可彻底关闭。
    match /classes/main_class {
      allow get: if true;
      allow list, write: if false;

      match /inspections/{inspectionId} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
